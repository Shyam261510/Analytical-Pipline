{
  "name": "instagram-reel-pipeline",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "worker": "bun run --hot src/worker.ts",
    "dev:all": "concurrently \"bun run dev\" \"bun run worker\"",
    "db:generate": "bunx prisma generate",
    "db:push": "bunx prisma db push",
    "db:studio": "bunx prisma studio",
    "typecheck": "bun check"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/fluent-ffmpeg": "^2.1.28",
    "concurrently": "^10.0.6"
  },
  "peerDependencies": {
    "typescript": "^7"
  },
  "dependencies": {
    "@google/genai": "^2.32.0",
    "@langchain/textsplitters": "^1.0.2",
    "axios": "^1.21.0",
    "bullmq": "^6.5.4",
    "fluent-ffmpeg": "^2.1.3",
    "ioredis": "^6.0.0",
    "ollama": "^0.6.4",
    "zod": "^4.6.7"
  }
}
