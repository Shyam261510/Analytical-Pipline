# Copy this file to .env and fill in the values. Never commit .env.

# --- Redis ---
# BullMQ connection (src/queue/config.ts)
REDIS_HOST=localhost
REDIS_PORT=6379
# Cache client (src/Provider/RedisProvider.ts): passed straight to ioredis,
# so a port (6379) or a full URL (redis://localhost:6379) both work.
REDIS_STACK_PORT=6379

# --- scrape.do (Instagram requests go through it) ---
SCRAPE_DO_TOKEN=
# Max parallel scrape.do requests per process (free plan allows 5). Default: 5
SCRAPE_DO_CONCURRENCY=5
# Max parallel video downloads / ffmpeg runs / transcriptions per process. Default: 12
MEDIA_CONCURRENCY=12

# --- Instagram ---
# Needed by handleExtractReelCode (Reels-tab GraphQL request)
FB_DTSG=
# Session cookie values used by src/shared/igAuth.ts (from a logged-in browser session)
IG_DS_USER_ID=
IG_SESSION_ID=
IG_CSRF_TOKEN=

# --- Google Gemini (audio transcription) ---
GEMINI_API_KEY=

# --- Cloudflare Browser Rendering (external URL crawl) ---
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
